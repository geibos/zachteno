# Пример окружения. Секреты — только в .env (в git не попадает).
BIND=0.0.0.0:8080
METRICS_BIND=127.0.0.1:9100
PUBLIC_URL=http://localhost:8080
# Подсеть обратного прокси (для X-Forwarded-For); пусто — заголовок не учитывается.
TRUSTED_PROXIES=
RUST_LOG=info,app=debug

DATABASE_URL=postgres://zachteno_app:<пароль>@127.0.0.1:55432/zachteno
MIGRATION_DATABASE_URL=postgres://zachteno_owner:<пароль>@127.0.0.1:55432/zachteno

# Перцы паролей: N:base64(≥32 байт), активен наибольший номер. openssl rand -base64 32
PASSWORD_PEPPERS=1:<base64>
# Ключ HMAC сигналов антифрода (≥32 байт). openssl rand -base64 32
SIGNAL_HMAC_KEY=<base64>
SIGNAL_RETENTION_DAYS=365

S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=attachments
S3_ACCESS_KEY_ID=<GK...>
S3_SECRET_ACCESS_KEY=<hex>

# MAIL_MODE=smtp — транзакционный SMTP-сервис (например, Yandex Cloud Postbox); directory — письма файлами в MAIL_DIR.
MAIL_MODE=directory
MAIL_DIR=./data/mail
MAIL_FROM="Зачтено <no-reply@tests.example.edu>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=<id API-ключа>
SMTP_PASSWORD=<секрет API-ключа>

# Яндекс ID (необязательно: без них кнопка входа скрыта).
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
